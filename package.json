{
  "name": "tropa",
  "version": "0.3.0",
  "private": true,
  "description": "Personal learning routes on top of your Obsidian notes",
  "license": "MIT",
  "author": "Darkildo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkildo/tropa.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint --max-warnings=0 src test scripts bench && npm run lint:css",
    "lint:css": "! grep -n '!important' styles.css",
    "demo": "tsx scripts/make-demo-vault.ts",
    "preview": "node harness/build.mjs",
    "e2e": "node harness/build.mjs && node harness/e2e.mjs",
    "screenshots": "node harness/build.mjs && node harness/screenshots.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "bench": "tsx bench/run.ts",
    "bench:chromium": "node bench/build.mjs && node bench/chromium.mjs",
    "build:wasm": "node scripts/build-wasm.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "binaryen": "132.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.14.0",
    "lucide": "^1.66.0",
    "obsidian": "^1.14.4",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
